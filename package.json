{
  "name": "php-proxy-hunter",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy Hunter Utility",
  "main": "./app/main.js",
  "type": "module",
  "license": "ISC",
  "author": {
    "name": "Dimas Lanjaka",
    "email": "dimaslanjaka@gmail.com",
    "url": "https://webmanajemen.com"
  },
  "bin": {
    "py": "./dist/cli/python-wrapper-cli.cjs",
    "proxy-checker-opencode": "./dist/cli/proxy-checker-opencode.cjs"
  },
  "files": [
    "./dist/cli/**/*",
    "./dist/assets/**/*",
    "./scripts/**/*"
  ],
  "repository": {
    "url": "https://github.com/dimaslanjaka/php-proxy-hunter",
    "type": "git"
  },
  "keywords": [
    "proxy",
    "php",
    "python",
    "fingerprint"
  ],
  "scripts": {
    "serve": "npm run dev:react",
    "start": "php -S 0.0.0.0:4000",
    "tailscale": "./bin/py tailscale/mysql-test.py",
    "build": "npm run build:packages && npm run build:rollup && npm run build:react",
    "build:cli": "rollup -c rollup.cli.js && py -m shiv -c proxy-checker-opencode -o dist/cli/proxy-checker-opencode.pyz .",
    "build:docs": "yarn workspace gh-pages-builder run build",
    "build:gh-pages": "node vite-gh-pages.runner.js",
    "build:packages": "node scripts/build-packages.mjs",
    "build:react": "npm run build:tailwind && cross-env NODE_OPTIONS=\"--max_old_space_size=4096 --openssl-legacy-provider\" vite build",
    "build:rollup": "rollup -c rollup.config.js",
    "build:tailwind": "node tailwind.build.js",
    "clean": "npm run clean:build && npm run clean:cli && npm run clean:react && npm run clean:rollup",
    "clean:build": "rimraf tmp/build",
    "clean:cli": "rimraf dist/cli",
    "clean:react": "rimraf dist/react",
    "clean:rollup": "rimraf dist/cli dist/assets",
    "dev:gh-pages": "npm run build:gh-pages && vite --config vite-gh-pages.config.js",
    "dev:react": "vite",
    "lint": "eslint --ext .js,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "normal-rebuild": "npm rebuild",
    "postinstall": "node scripts/postinstall.js",
    "prepare": "npx husky && node setup.js",
    "prepare:react": "node vite-plugin.js",
    "preview:gh-pages": "npm run build:gh-pages && vite preview --config vite-gh-pages.config.js",
    "preview:react": "npm run build:react && vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand --detectOpenHandles",
    "test:coverage": "npm test -- --coverage",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand --detectOpenHandles",
    "test:watch": "npm test -- --watch",
    "update:ncu": "npx npm-check-updates -u --reject='typescript,ts-node'",
    "update:sha": "npx binary-collections pkg-res-updater"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
